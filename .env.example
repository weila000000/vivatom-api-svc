# Gin listen address
VIVATOM_HTTP_ADDRESS=:8080

# Persistent SQLite file, relative to vivatom-api-svc when using go run.
VIVATOM_RUNTIME_DATABASE_PATH=.data/vivatom-runtime.db

# Browser origin and HTTP lifecycle.
VIVATOM_ALLOWED_ORIGIN=http://localhost:5173
# Comma-separated proxy IPs/CIDRs. Leave empty when Gin is directly exposed.
# VIVATOM_TRUSTED_PROXIES=172.16.0.0/12
VIVATOM_HTTP_READ_TIMEOUT=15s
VIVATOM_HTTP_WRITE_TIMEOUT=5m
VIVATOM_HTTP_IDLE_TIMEOUT=60s
VIVATOM_SHUTDOWN_TIMEOUT=10s

# Per-IP limits in one shared time window. Login and registration are separate buckets.
VIVATOM_AUTH_RATE_LIMIT=20
VIVATOM_AGENT_RATE_LIMIT=10
VIVATOM_RATE_LIMIT_WINDOW=1m

# Isolated build worker. The API never executes generated source itself.
VIVATOM_BUILDER_URL=http://localhost:8090
VIVATOM_BUILDER_TOKEN=vivatom-local-builder
VIVATOM_BUILDER_TIMEOUT=50s
VIVATOM_BUILDER_CONCURRENCY=2
VIVATOM_PREVIEW_PORT=8091

# Agent provider: auto uses OpenAI when a key exists, otherwise the local fake.
VIVATOM_AI_PROVIDER=auto
# VIVATOM_AI_API_KEY=
VIVATOM_AI_BASE_URL=https://vibe.linux008.com/v1
VIVATOM_AI_MODEL=gpt-6-astra
# Optional role overrides. Empty values inherit VIVATOM_AI_MODEL.
# VIVATOM_AI_ANALYST_MODEL=
# VIVATOM_AI_ARCHITECT_MODEL=
# VIVATOM_AI_BUILDER_MODEL=
# VIVATOM_AI_TIMEOUT=5m
# VIVATOM_AI_MAX_RETRIES=2
